# -----------------------------
# OpenMetadata MCP configuration
# -----------------------------
# Base OpenMetadata URL (without /mcp)
OPENMETADATA_URL=
# OpenMetadata Personal Access Token
OPENMETADATA_TOKEN=
# MCP endpoint path
MCP_ENDPOINT=/mcp

# -----------------------------
# LLM provider configuration
# -----------------------------
# groq | gemini | anthropic
LLM_PROVIDER=groq
# Groq default: llama-3.3-70b-versatile
LLM_MODEL=llama-3.3-70b-versatile
GROQ_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# -----------------------------
# Verdax / app settings
# -----------------------------
MAX_UPLOAD_SIZE_MB=100
TEMP_UPLOAD_DIR=/tmp/verdax_uploads
REPORTS_DIR=reports/agent
SQLITE_PATH=meta_verdax_sessions.db

# -----------------------------
# MongoDB persistence
# -----------------------------
MONGODB_URI=
MONGODB_DB=verdax
MONGODB_SCANS_COLLECTION=verdax_scans

# -----------------------------
# API / dashboard runtime
# -----------------------------
API_BASE_URL=http://localhost:8000

# -----------------------------
# Risk thresholds
# -----------------------------
CRITICAL_DRIFT_THRESHOLD=0.8
WARN_DRIFT_THRESHOLD=0.2
CRITICAL_ANOMALY_RATE=0.15
